@startuml class-diagram
title Restaurant Rush - Stage 3 Class Diagram (Host, combo meals, Happy Hour)

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
hide empty members

legend top right
  <back:#D5F5D5>   </back> New in Stage 3
  <back:#FFF2C2>   </back> Changed in Stage 3
  No colour: unchanged since stage-2
endlegend

package "boundary" {
  class ConsoleUI <<boundary>> #FFF2C2 {
    - scanner : Scanner
    - maxTurns : int
    + ConsoleUI(scanner : Scanner, maxTurns : int)
    + showStartOfTurn(turn : int, restaurant : Restaurant) : void
    + showEndOfTurn(turn : int, r : Restaurant) : void
    + showFinalResult(won : boolean, stats : GameStats, objective : Objective) : void
    + askWaiterTask() : WaiterTask
    + askCustomerId(prompt : String) : int
    + askTableNo(numTables : int) : int
    + askOrderIdOrWait() : int
    + showError(reason : String) : void
    + showMessage(message : String) : void
    + askStartHappyHour() : boolean
    + showHappyHourStatus(turnsLeft : int) : void
    + askHostCustomerIdOrWait() : int
    - averageText(stats : GameStats) : String
    - passOrFail(passed : boolean) : String
    - readInt(min : int, max : int) : int
  }
}

package "control" {
  class Main <<control>> #FFF2C2 {
    + {static} main(args : String[]) : void
  }

  class GameController <<control>> #FFF2C2 {
    - currentTurn : int
    + GameController(restaurant : Restaurant, ui : ConsoleUI, schedule : ArrivalSchedule, objective : Objective)
    + run() : void
    - playTurn() : void
    - handleArrivals() : void
    - handleHappyHour() : void
    - handleHost() : void
    - handleWaiter() : void
    - handleChef() : void
    - handleEatingAndPayment() : void
    - handleEndOfTurnWaiting() : void
    - currentPricing() : PricingPolicy
    - getCustomerOrThrow(id : int) : Customer
    - getOrderOrThrow(id : int) : Order
  }

  class ArrivalSchedule <<control>> {
    - arrivalTurns : List<Integer>
    - arrivalTypes : List<CustomerType>
    - nextCustomerId : int
    + ArrivalSchedule(arrivalTurns : List<Integer>, arrivalTypes : List<CustomerType>)
    + customersArrivingAt(turn : int) : List<Customer>
    - createCustomer(type : CustomerType, id : int, turn : int) : Customer
  }

  class Objective <<control>> {
    - minPaidCustomers : int
    - minRevenueCents : int
    - minAvgSatisfaction : int
    + Objective(minPaidCustomers : int, minRevenueCents : int, minAvgSatisfaction : int)
    + isMet(stats : GameStats) : boolean
    + paidTargetMet(stats : GameStats) : boolean
    + revenueTargetMet(stats : GameStats) : boolean
    + satisfactionTargetMet(stats : GameStats) : boolean
    + getMinPaidCustomers() : int
    + getMinRevenueCents() : int
    + getMinAvgSatisfaction() : int
  }

  class GameConfig <<control>> {
    + {static} MAX_TURNS : int = 18
    + {static} NUM_TABLES : int = 2
    + {static} ARRIVAL_TURNS : List<Integer>
    + {static} ARRIVAL_TYPES : List<CustomerType>
    + {static} ALL_REGULAR : List<CustomerType>
    + {static} TARGET_PAID : int = 4
    + {static} TARGET_REVENUE_CENTS : int = 4500
    + {static} TARGET_AVG_SATISFACTION : int = 60
  }
}

package "entity" {
  class Restaurant <<entity>> #FFF2C2 {
    - waitingQueue : List<Customer>
    - allCustomers : List<Customer>
    - allOrders : List<Order>
    + Restaurant(numTables : int)
    + addArrival(c : Customer) : void
    + removeFromQueue(c : Customer) : void
    + customerLeft(c : Customer) : void
    + getWaitingQueue() : List<Customer>
    + getAllCustomers() : List<Customer>
    + getTables() : List<Table>
    + getAllStaff() : List<Staff>
    + findCustomer(id : int) : Customer
    + findOrder(orderId : int) : Order
    + getTable(tableNo : int) : Table
    + findTableOf(c : Customer) : Table
    + addOrder(o : Order) : void
    + getMenu() : Menu
    + getWaiter() : Waiter
    + getHost() : Host
    + getChef() : Chef
    + getCashier() : Cashier
    + getStats() : GameStats
  }

  abstract class Customer <<entity>> #FFF2C2 {
    - customerId : int
    - arrivalTurn : int
    - satisfaction : int
    - status : CustomerStatus
    - servedTurn : int
    - readyToPayTurn : int
    - paidSatisfaction : int
    + Customer(customerId : int, arrivalTurn : int)
    + getCustomerId() : int
    + getSatisfaction() : int
    + getStatus() : CustomerStatus
    + getPaidSatisfaction() : int
    + getServedTurn() : int
    + getReadyToPayTurn() : int
    + chooseMenuItem(menu : Menu) : MenuItem
    + calculateBill(basePriceCents : int) : int
    + {abstract} getSatisfactionDecay() : int
    + {abstract} getTypeLabel() : String
    + {leaf} decreaseSatisfaction() : boolean
    + {leaf} recoverSatisfaction(points : int) : boolean
    + {leaf} seat() : void
    + {leaf} orderTaken() : void
    + {leaf} serve(turn : int) : void
    + {leaf} finishEating(turn : int) : void
    + {leaf} markPaid(turn : int) : void
    + isReadyToPay() : boolean
    + toString() : String
  }

  class RegularCustomer <<entity>> {
    + RegularCustomer(customerId : int, arrivalTurn : int)
    + getSatisfactionDecay() : int
    + getTypeLabel() : String
  }

  class VIPCustomer <<entity>> {
    + VIPCustomer(customerId : int, arrivalTurn : int)
    + getSatisfactionDecay() : int
    + calculateBill(basePriceCents : int) : int
    + getTypeLabel() : String
  }

  class CriticCustomer <<entity>> {
    + CriticCustomer(customerId : int, arrivalTurn : int)
    + getSatisfactionDecay() : int
    + chooseMenuItem(menu : Menu) : MenuItem
    + getTypeLabel() : String
  }

  enum CustomerType <<enumeration>> {
    REGULAR
    VIP
    CRITIC
  }

  enum CustomerStatus <<enumeration>> {
    WAITING
    SEATED
    WAITING_FOR_FOOD
    SERVED
    READY_TO_PAY
    PAID
    LEFT
  }

  class Table <<entity>> {
    - tableNo : int
    + Table(tableNo : int)
    + isFree() : boolean
    + assign(c : Customer) : void
    + release() : void
    + getTableNo() : int
    + getOccupant() : Customer
  }

  class Menu <<entity>> #FFF2C2 {
    + Menu()
    + addItem(item : MenuItem) : void
    + getItem(index : int) : MenuItem
    + size() : int
  }

  class MenuItem <<entity>> {
    - name : String
    - priceCents : int
    - prepUnits : int
    + MenuItem(name : String, priceCents : int, prepUnits : int)
    + getName() : String
    + getPriceCents() : int
    + getPrepUnits() : int
  }

  class Order <<entity>> {
    - orderId : int
    - billCents : int
    - unitsDone : int
    - status : OrderStatus
    + Order(orderId : int, customer : Customer, item : MenuItem, billCents : int)
    + advanceOneUnit() : void
    + markServed() : void
    + markPaid() : void
    + cancel() : void
    + isReady() : boolean
    + getOrderId() : int
    + getCustomer() : Customer
    + getItem() : MenuItem
    + getBillCents() : int
    + getUnitsDone() : int
    + getStatus() : OrderStatus
  }

  enum OrderStatus <<enumeration>> {
    IN_PREPARATION
    READY
    SERVED
    PAID
    CANCELLED
  }

  abstract class Staff <<entity>> {
    - roleName : String
    - actedThisTurn : boolean
    # Staff(roleName : String)
    + startNewTurn() : void
    + hasActedThisTurn() : boolean
    # checkCanAct() : void
    # markActed() : void
  }

  class Waiter <<entity>> #FFF2C2 {
    + Waiter()
    + seat(c : Customer, t : Table) : void
    + takeOrder(c : Customer, menu : Menu, pricing : PricingPolicy) : Order
    + serve(o : Order, turn : int) : void
  }

  class Host <<entity>> #D5F5D5 {
    + Host()
    + seat(c : Customer, t : Table) : void
  }

  class ComboMeal <<entity>> #D5F5D5 {
    - first : MenuItem
    - second : MenuItem
    + ComboMeal(first : MenuItem, second : MenuItem)
    + getFirst() : MenuItem
    + getSecond() : MenuItem
  }

  interface PricingPolicy <<interface>> #D5F5D5 {
    + applyTo(billCents : int) : int
  }

  class StandardPricing <<entity>> #D5F5D5 {
    + StandardPricing()
    + applyTo(billCents : int) : int
  }

  class HappyHour <<entity>> #D5F5D5 {
    + {static} DURATION_TURNS : int = 2
    + {static} RECOVERY_POINTS : int = 15
    - used : boolean
    - turnsLeft : int
    + HappyHour()
    + activate() : void
    + isActive() : boolean
    + isAvailable() : boolean
    + getTurnsLeft() : int
    + endTurn() : void
    + applyTo(billCents : int) : int
  }

  class Chef <<entity>> {
    + Chef()
    + prepare(o : Order) : void
  }

  class Cashier <<entity>> {
    + Cashier()
    + processNextPayment(restaurant : Restaurant, turn : int) : Customer
  }

  class GameStats <<entity>> {
    - revenueCents : int
    - paidSatisfactions : List<Integer>
    - servedCount : int
    - unhappyDepartures : int
    + recordPayment(billCents : int, satisfaction : int) : void
    + recordServed() : void
    + recordDeparture() : void
    + getRevenueCents() : int
    + getPaidCount() : int
    + getServedCount() : int
    + getUnhappyDepartures() : int
    + getAverageSatisfaction() : double
  }

  enum WaiterTask <<enumeration>> {
    SEAT
    TAKE_ORDER
    SERVE
    WAIT
  }

  class InvalidActionException <<exception>> {
    + InvalidActionException(reason : String)
  }

  class Money <<utility>> {
    + {static} format(cents : int) : String
  }
}

' ---------- control wiring ----------
Main ..> GameController : <<create>>
Main ..> Restaurant : <<create>>
Main ..> ConsoleUI : <<create>>
Main ..> ArrivalSchedule : <<create>>
Main ..> Objective : <<create>>
Main ..> ComboMeal : <<create>> registers 2 combos

GameController --> "1" Restaurant : restaurant
GameController --> "1" ConsoleUI : ui
GameController --> "1" ArrivalSchedule : schedule
GameController --> "1" Objective : objective
GameController ..> InvalidActionException : catches
GameController *-- "1" HappyHour : happyHour
GameController *-- "1" StandardPricing : standardPricing

Main ..> GameConfig : reads ARRIVAL_TYPES / ALL_REGULAR
ArrivalSchedule ..> RegularCustomer : <<create>>
ArrivalSchedule ..> VIPCustomer : <<create>>
ArrivalSchedule ..> CriticCustomer : <<create>>
ArrivalSchedule --> "0..*" CustomerType : arrivalTypes
GameConfig ..> CustomerType
Objective ..> GameStats : reads

ConsoleUI ..> Restaurant : displays
ConsoleUI ..> WaiterTask : returns
ConsoleUI ..> Money : uses

' ---------- entity structure ----------
Restaurant "1" *-- "2" Table : tables
Restaurant "1" *-- "1" Menu : menu
Restaurant "1" *-- "1" Waiter : waiter
Restaurant "1" *-- "1" Host : host
Restaurant "1" *-- "1" Chef : chef
Restaurant "1" *-- "1" Cashier : cashier
Restaurant "1" *-- "1" GameStats : stats
Restaurant "1" o-- "0..*" Customer : customers
Restaurant "1" o-- "0..*" Order : orders

Menu "1" o-- "3..*" MenuItem : items
Order "0..1" --> "1" Customer : customer
Order "0..*" --> "1" MenuItem : item
Order --> "1" OrderStatus
Table "0..1" --> "0..1" Customer : occupant
Customer --> "1" CustomerStatus

Customer <|-- RegularCustomer
Customer <|-- VIPCustomer
Customer <|-- CriticCustomer
Staff <|-- Waiter
Staff <|-- Chef
Staff <|-- Cashier
Staff <|-- Host
MenuItem <|-- ComboMeal
ComboMeal "0..*" o-- "2" MenuItem : first, second
PricingPolicy <|.. StandardPricing
PricingPolicy <|.. HappyHour

Waiter ..> Order : <<create>>
Waiter ..> InvalidActionException : throws
Chef ..> InvalidActionException : throws
Host ..> InvalidActionException : throws
HappyHour ..> InvalidActionException : throws
Waiter ..> PricingPolicy : pricing.applyTo(bill)
Cashier ..> Restaurant : looks up order/table

' ---------- annotations ----------
note right of Customer
  <b>Encapsulation:</b> satisfaction is private with no setter.
  It only changes in decreaseSatisfaction(), which clamps it
  at 0 and moves the customer to LEFT, and in
  recoverSatisfaction() (Happy Hour), which caps it at 100.
  <b>Polymorphism:</b> getSatisfactionDecay() and getTypeLabel()
  are abstract (Regular = 8, VIP = 5, Critic = 12). The state
  transitions are final ({leaf}), so every subclass follows
  the same seat, order, serve, eat, pay flow (LSP).
end note

note bottom of VIPCustomer
  <b>Overriding (LSP):</b> calculateBill() calls
  super.calculateBill() first, keeping the parent's
  negative-price check, then returns price * 90 / 100
  in integer cents ($15.00 Burger -> $13.50).
end note

note bottom of CriticCustomer
  <b>Overriding:</b> chooseMenuItem() always returns the
  most expensive item (Salad + Pasta since Stage 3);
  on a tie the earlier menu item wins. Same hook the Waiter already calls.
end note

note right of ArrivalSchedule
  <b>Single creation point:</b> createCustomer() is the only
  place that names a concrete customer class. Which arrival
  is which type comes from GameConfig (turn 4 = VIP,
  turn 10 = Critic), so the turn loop never needs it.
end note

note bottom of Staff
  <b>One task per turn:</b> each role calls checkCanAct()
  first and markActed() only after its own checks pass,
  so a rejected choice never uses up the task.
  Each role exposes only its own actions (no fat interface).
end note

note top of Restaurant
  <b>Composition:</b> Restaurant creates and owns its Tables,
  Menu, staff and GameStats; they have no meaning outside it.
  Customers and Orders are aggregated (created elsewhere).
  Lists are handed out unmodifiable.
end note

note bottom of Order
  <b>Encapsulation:</b> billCents is final, locked when the
  order is taken. Status only moves forward through
  advanceOneUnit() / markServed() / markPaid().
end note

note left of GameController
  <b>Changed in Stage 3:</b> two new steps, handleHappyHour()
  and handleHost(), run before the Waiter. It still never uses
  instanceof on customers. It picks the PricingPolicy for the
  turn (currentPricing()) and passes it to the Waiter, so the
  Waiter never knows which discount is running.
end note

note right of PricingPolicy
  <b>DIP:</b> Waiter.takeOrder() depends on the PricingPolicy
  abstraction, not on HappyHour. The policy is passed in as a
  parameter (dependency, not a field), because it changes from
  turn to turn.
  <b>Polymorphism:</b> pricing.applyTo(bill) runs
  StandardPricing (unchanged) or HappyHour (20% off,
  (cents * 80 + 50) / 100) depending on the object.
end note

note bottom of HappyHour
  <b>Encapsulation:</b> used and turnsLeft are private.
  They only change through activate() (once per game,
  else InvalidActionException) and endTurn().
end note

note bottom of ComboMeal
  <b>Inheritance + aggregation:</b> a ComboMeal is a MenuItem
  (LSP), so Order, Chef and CriticCustomer work with it
  unchanged. It holds 2 existing menu items that live on
  without it. Price = 90% of both, units = both added.
end note

note right of Host
  <b>ISP:</b> seat() is on Host and Waiter only, not on
  Staff, so Chef and Cashier never get it. Host keeps
  Staff's one-task-per-turn rule (checkCanAct/markActed).
end note
@enduml
